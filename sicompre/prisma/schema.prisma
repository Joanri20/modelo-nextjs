generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AssetGroup {
  id          BigInt    @id @default(autoincrement())
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  assets      Asset[]
}

model Asset {
  id              BigInt          @id @default(autoincrement())
  description     String
  assetGroupId    BigInt
  currentValue    Float?          @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime?       @updatedAt
  assetGroup      AssetGroup      @relation(fields: [assetGroupId], references: [id])
  assetQuantities AssetQuantity[]
}

model AssetQuantity {
  id             BigInt          @id @default(autoincrement())
  assetId        BigInt
  quantity       Float           @default(1)
  purchasePlanId BigInt?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime?       @updatedAt
  quotationId    BigInt?
  asset          Asset           @relation(fields: [assetId], references: [id])
  purchasePlan   PurchasePlan?   @relation(fields: [purchasePlanId], references: [id])
  quotation      Quotation?      @relation(fields: [quotationId], references: [id])
  assetSuppliers AssetSupplier[]
}

model PurchasePlan {
  id              BigInt             @id @default(autoincrement())
  date            DateTime           @default(now())
  status          Enum_ProcessStatus @default(Open)
  totalValue      Float?             @default(0)
  departmentId    BigInt
  userId          String
  hiringCycleId   BigInt?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  assetQuantities AssetQuantity[]
  department      Department         @relation(fields: [departmentId], references: [id])
  hiringCycle     HiringCycle?       @relation(fields: [hiringCycleId], references: [id])
  user            User               @relation(fields: [userId], references: [id])
}

model AssetSupplier {
  value           Float         @default(0)
  assetQuantityId BigInt
  supplierId      BigInt
  createdAt       DateTime      @default(now())
  updatedAt       DateTime?     @updatedAt
  quotationId     BigInt
  assetQuantity   AssetQuantity @relation(fields: [assetQuantityId], references: [id])
  quotation       Quotation     @relation(fields: [quotationId], references: [id])
  supplier        Supplier      @relation(fields: [supplierId], references: [id])

  @@id([quotationId, supplierId])
}

model Supplier {
  id                    BigInt              @id @default(autoincrement())
  name                  String
  taxId                 String
  address               String
  email                 String
  phone                 String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  password              String?             @default("$1234")
  namePersonResponsible String?             @default("Responsable")
  website               String?
  assetSuppliers        AssetSupplier[]
  quotationSuppliers    QuotationSupplier[]
}

model QuotationSupplier {
  totalValue  Float     @default(0)
  supplierId  BigInt
  quotationId BigInt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  supplier    Supplier  @relation(fields: [supplierId], references: [id])

  @@id([quotationId, supplierId])
}

model Quotation {
  id                 BigInt               @id @default(autoincrement())
  startDate          DateTime             @default(now())
  endDate            DateTime             @default(now())
  status             Enum_QuotationStatus
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  userId             String
  entityId           BigInt
  assetQuantities    AssetQuantity[]
  assetSuppliers     AssetSupplier[]
  hiringCycles       HiringCycle[]
  entity             Entity               @relation(fields: [entityId], references: [id])
  user               User                 @relation(fields: [userId], references: [id])
  quotationSuppliers QuotationSupplier[]
}

model HiringCycle {
  id            BigInt             @id @default(autoincrement())
  startDate     DateTime           @default(now())
  endDate       DateTime           @default(now())
  status        Enum_ProcessStatus
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  userId        String
  entityId      BigInt
  quotationId   BigInt?
  entity        Entity             @relation(fields: [entityId], references: [id])
  quotation     Quotation?         @relation(fields: [quotationId], references: [id])
  user          User               @relation(fields: [userId], references: [id])
  purchasePlans PurchasePlan[]
}

model Entity {
  id                   BigInt             @id @default(autoincrement())
  name                 String
  taxId                String
  address              String?
  phone                String?
  city                 String
  state                String
  country              String
  website              String?
  email                String?
  possessionResolution String?
  possessionDate       DateTime?
  status               Enum_GeneralStatus @default(Active)
  availableBalance     Float              @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  departments          Department[]
  hiringCycles         HiringCycle[]
  quotations           Quotation[]
  members              User[]             @relation("EntityToUser")
}

model Department {
  id                   BigInt             @id @default(autoincrement())
  name                 String
  taxId                String
  address              String?
  phone                String?
  city                 String
  state                String
  country              String
  website              String?
  email                String?
  possessionResolution String?
  possessionDate       DateTime?
  status               Enum_GeneralStatus @default(Active)
  availableBalance     Float
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  entityId             BigInt
  userId               String?
  parentEntity         Entity             @relation(fields: [entityId], references: [id])
  user                 User?              @relation(fields: [userId], references: [id])
  purchasePlans        PurchasePlan[]
}

model User {
  id             String             @id
  firstName      String
  middleName     String?
  lastName       String
  secondLastName String?
  documentType   Enum_DocumentType  @default(CC)
  document       String
  phone          String?
  mobile         String
  email          String             @unique
  address        String?
  status         Enum_GeneralStatus @default(Active)
  type           Enum_UserType      @default(Manager)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  password       String             @default("1234")
  departments    Department[]
  hiringCycles   HiringCycle[]
  purchasePlans  PurchasePlan[]
  quotations     Quotation[]
  entities       Entity[]           @relation("EntityToUser")

  @@unique([documentType, document])
}

enum Enum_DocumentType {
  CC
  CE
  TI
  PASSPORT
}

enum Enum_ProcessStatus {
  Open
  Closed
  InProcess
}

enum Enum_UserType {
  Administrator
  Manager
}

enum Enum_GeneralStatus {
  Active
  Disabled
}

enum Enum_QuotationStatus {
  Open
  Closed
}
