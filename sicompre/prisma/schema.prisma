// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Todos los Enum

enum Enum_TipoDocumento {
  CC
  CE
  TI
  PASAPORTE
}

enum Enum_EstadoProceso {
  Abierto
  Cerrado
  EnProceso
}

enum Enum_TipoUsuario {
  Administrador
  Encargado
}

enum Enum_EstadoGeneral {
  Activo
  Deshabilitado
}

enum Enum_EstadoCotizacion {
  Abierto
  Cerrado
}

// Modelos

model GrupoBien {
  id          BigInt    @id @default(autoincrement())
  descripcion String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  Bien        Bien[]
}

model Bien {
  id           BigInt         @id @default(autoincrement())
  descripcion  String
  grupoBien    GrupoBien      @relation(fields: [grupoBienId], references: [id])
  grupoBienId  BigInt
  valorVigente Float?         @default(0)
  bienCantidad BienCantidad[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime?      @updatedAt
}

model BienCantidad {
  id              BigInt          @id @default(autoincrement())
  bien            Bien            @relation(fields: [bienId], references: [id])
  bienId          BigInt
  cantidad        Float           @default(1)
  planDeCompras   PlanDeCompras?  @relation(fields: [planDeComprasId], references: [id])
  planDeComprasId BigInt?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime?       @updatedAt
  BienProveedor   BienProveedor[]
  Cotizacion      Cotizacion?     @relation(fields: [cotizacionId], references: [id])
  cotizacionId    BigInt?
}

model PlanDeCompras {
  id                  BigInt             @id @default(autoincrement())
  bienes              BienCantidad[]
  fecha               DateTime           @default(now())
  estado              Enum_EstadoProceso @default(Abierto)
  dependencia         Dependencia        @relation(fields: [dependenciaId], references: [id])
  usuario             Usuario            @relation(fields: [usuarioId], references: [id])
  valorTotal          Float?             @default(0)
  dependenciaId       BigInt
  usuarioId           String
  cicloContratacion   CicloContratacion? @relation(fields: [cicloContratacionId], references: [id])
  cicloContratacionId BigInt?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model BienProveedor {
  bien           BienCantidad @relation(fields: [bienCantidadId], references: [id])
  proveedor      Proveedor    @relation(fields: [proveedorId], references: [id])
  valor          Float        @default(0)
  cotizacion     Cotizacion   @relation(fields: [cotizacionId], references: [id])
  bienCantidadId BigInt
  proveedorId    BigInt
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt
  cotizacionId   BigInt

  @@id([cotizacionId, proveedorId])
}

model Proveedor {
  id            BigInt                @id @default(autoincrement())
  nombre        String
  nit           String
  direccion     String
  email         String
  telefono      String
  cotizaciones  CotizacionProveedor[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  BienProveedor BienProveedor[]
}

model CotizacionProveedor {
  proveedor    Proveedor  @relation(fields: [proveedorId], references: [id])
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id])
  valorTotal   Float      @default(0)
  proveedorId  BigInt
  cotizacionId BigInt
  createdAt    DateTime   @default(now())
  updatedAt    DateTime?  @updatedAt

  @@id([cotizacionId, proveedorId])
}

model Cotizacion {
  id                  BigInt                @id @default(autoincrement())
  fechaInicio         DateTime              @default(now())
  fechaFinal          DateTime              @default(now())
  usuario             Usuario               @relation(fields: [usuarioId], references: [id])
  entidad             Entidad               @relation(fields: [entidadId], references: [id])
  estado              Enum_EstadoCotizacion
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  usuarioId           String
  entidadId           BigInt
  BienProveedor       BienProveedor[]
  CotizacionProveedor CotizacionProveedor[]
  BienCantidad        BienCantidad[]
  CicloContratacion   CicloContratacion[]
}

model CicloContratacion {
  id            BigInt             @id @default(autoincrement())
  fechaInicio   DateTime           @default(now())
  fechaFinal    DateTime           @default(now())
  planDeCompras PlanDeCompras[]
  usuario       Usuario            @relation(fields: [usuarioId], references: [id])
  estado        Enum_EstadoProceso
  entidad       Entidad            @relation(fields: [entidadId], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  usuarioId     String
  entidadId     BigInt
  Cotizacion    Cotizacion?        @relation(fields: [cotizacionId], references: [id])
  cotizacionId  BigInt?
}

model Entidad {
  id                 BigInt              @id @default(autoincrement())
  nombre             String
  nit                String
  direccion          String?
  telefono           String?
  municipio          String
  departamento       String
  pais               String
  web                String?
  email              String?
  resolucionPosesion String?
  fechaPosesion      DateTime?
  estado             Enum_EstadoGeneral  @default(Activo)
  saldoDisponible    Float               @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  dependencias       Dependencia[]
  cicloContratacion  CicloContratacion[]
  integrantes        Usuario[]
  Cotizacion         Cotizacion[]
}

model Dependencia {
  id                 BigInt             @id @default(autoincrement())
  nombre             String
  nit                String
  direccion          String?
  telefono           String?
  municipio          String
  departamento       String
  pais               String
  web                String?
  email              String?
  resolucionPosesion String?
  fechaPosesion      DateTime?
  estado             Enum_EstadoGeneral @default(Activo)
  entidadPadre       Entidad            @relation(fields: [entidadId], references: [id])
  saldoDisponible    Float
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  entidadId          BigInt
  Cotizacion         PlanDeCompras[]
  Usuario            Usuario?           @relation(fields: [usuarioId], references: [id])
  usuarioId          String?

  @@map("Dependecia")
}

model Usuario {
  id                String              @id
  primerNombre      String
  segundoNombre     String?
  primerApellido    String
  segundoApellido   String?
  tipoDocumento     Enum_TipoDocumento  @default(CC)
  documento         String
  telefono          String?
  celular           String
  email             String              @unique
  direccion         String?
  estado            Enum_EstadoGeneral  @default(Activo)
  tipo              Enum_TipoUsuario    @default(Encargado)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  entidad           Entidad[]
  dependencia       Dependencia[]
  cotizacion        PlanDeCompras[]
  cicloContratacion CicloContratacion[]
  password          String              @default("1234")
  Cotizacion        Cotizacion[]

  @@unique([tipoDocumento, documento])
}
